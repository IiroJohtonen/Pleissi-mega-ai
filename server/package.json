{
  "name": "kotilo-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "backup": "tsx src/backup-cli.ts",
    "eval": "node --import tsx eval/run.ts",
    "eval:retrieval": "node --import tsx eval/retrieval.ts",
    "embeddings:download": "tsx src/embedding-cli.ts download",
    "embeddings:rebuild": "tsx src/embedding-cli.ts rebuild",
    "lint": "eslint ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@google-cloud/local-auth": "^3.0.1",
    "@huggingface/transformers": "^4.3.2",
    "better-sqlite3": "^12.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "googleapis": "^185.0.0",
    "helmet": "^8.3.0",
    "imapflow": "^2.4.2",
    "mailparser": "^3.9.39",
    "mammoth": "^1.13.0",
    "nodemailer": "^10.1.1",
    "sqlite-vec": "^0.1.9",
    "tesseract.js": "^7.0.0",
    "unpdf": "^1.8.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "eslint": "^10.12.0",
    "tsx": "^4.19.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.2"
  }
}
