PORT=4000
DEFAULT_COMPANY_ID=demo-company
AUTHORIZED_COMPANY_IDS=demo-company

# Claude-avain AI-ehdotuksia ja raportteja varten. Ilman avainta käytetään avainsanahakua.
ANTHROPIC_API_KEY=
# Valinnainen, raporttien ja saapuvien viestien arvioinnin malli, oletus claude-opus-5-5
ANTHROPIC_MODEL=
# Valinnainen, vastausehdotusten malli, oletus claude-sonnet-5-5
ANTHROPIC_REPLY_MODEL=
# Valinnainen, dokumenttien pilkonnan ja luokittelun nopea malli, oletus claude-haiku-5-5
ANTHROPIC_FAST_MODEL=

# Ensimmäisten käyttäjien salasana tyhjään tietokantaan. Tyhjänä salasana arvotaan ja tulostetaan lokiin.
INITIAL_PASSWORD=

# Osoite, jossa käyttöliittymä on. Käytetään salasanan palautuslinkeissä ja sallittuna selainosoitteena.
APP_URL=http://localhost:5173
# Sallitut selainosoitteet pilkuilla erotettuna, jos niitä on useita. Oletus on APP_URL.
CORS_ORIGINS=
# Kotisivun yhteydenottolomakkeen pyynnöt välitetään tähän osoitteeseen (niitä ei tallenneta alustalle).
# Tyhjänä käytetään aiemmin asetuksiin tallennettua osoitetta.
CONTACT_FORWARD_EMAIL=
# Luotettavien välityspalvelimien määrä (esim. 1), kun palvelin on käänteisen välityspalvelimen takana.
TRUST_PROXY=

# Tietokannan ja liitteiden kansio. Oletus on käynnistyskansion data-kansio.
DATA_DIR=
# Kun asetettu, varmuuskopio otetaan tähän kansioon kerran päivässä. BACKUP_KEEP = säilytettävien määrä (oletus 14).
BACKUP_DIR=
BACKUP_KEEP=

# ClamAV-palvelun (clamd) osoite liitteiden virustarkistusta varten. Tyhjänä estetään vain ajettavat tiedostot.
CLAMAV_HOST=
CLAMAV_PORT=3310

# 1 = postia ei tarkisteta eikä lähetetä (testit ja kokeiluympäristöt).
GMAIL_DISABLED=

# Osoite, johon Googlen kirjautuminen palaa. Oletus on http://localhost:<PORT>/api/gmail/callback.
GMAIL_REDIRECT_URI=

# Googlen OAuth-clientin tiedoston polku. Oletus on server/credentials.json.
GMAIL_CREDENTIALS_FILE=

# Microsoft 365 / Outlook: Azure-portaaliin rekisteröidyn sovelluksen tunniste ja salaisuus.
# Tyhjänä Microsoft 365 -yhteys ei ole käytössä. Ohje: deploy/server/README.md, kohta "Sähköposti".
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Organisaatio, jonka tileillä saa kirjautua. "common" sallii kaikki työ- ja henkilökohtaiset tilit.
MS_TENANT=
# Osoite, johon Microsoftin kirjautuminen palaa. Oletus on http://localhost:<PORT>/api/mail/microsoft/callback.
MS_REDIRECT_URI=

# IMAP/SMTP-tilien salasanat ja Microsoftin tunnisteet salataan tällä avaimella (64 heksamerkkiä,
# esim. komennolla: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
# Tyhjänä avain luodaan tiedostoon DATA_DIR/mail-secret.key. Jos avain katoaa, tilit pitää yhdistää uudelleen.
MAIL_SECRET_KEY=

# ERP-integraatio (docs/integraatiospec.md). Tyhjänä integraatio ei ole käytössä eikä muutoksia kirjata
# jonoon. "mock" = ERP:tä simuloiva adapteri kehitykseen ja testeihin.
INTEGRATION_ADAPTER=
# Asiakkaan (isännöintitoimiston) tunniste sanomissa (tenantId).
INTEGRATION_TENANT_ID=
# Lähetyksen viive tehtävän viimeisimmästä muutoksesta millisekunteina (oletus 5000). Viiveen aikana
# tulleista saman tehtävän muutoksista lähetetään vain uusin.
INTEGRATION_SEND_DELAY_MS=
# Uudelleenyritysten välit millisekunteina pilkuilla erotettuna (oletus 60000,300000,1800000).
INTEGRATION_RETRY_DELAYS_MS=
# true = ERP hakee muutokset jonosta (GET /api/v1/events), eikä hakua voi kytkeä pois asetuksista. Tyhjänä haun
# kytkee pääkäyttäjä (Asetukset › Tietoturva › ERP-rajapinta). Käytössä vain, kun INTEGRATION_ADAPTER on tyhjä.
INTEGRATION_PULL=
# Integraatiorajapinnan /api/v1 pyyntöraja API-avainta kohden minuutissa (oletus 120).
API_V1_RATE_LIMIT_PER_MINUTE=

# Merkityshaku (embedding.ts). Käyttö kytketään asetuksista (Asetukset › AI › Merkityshaku), oletuksena pois.
# false = hätäkatkaisin: vektoreita ei lasketa eikä käytetä asetuksista riippumatta.
EMBEDDING_ENABLED=
# Malli (oletus Xenova/multilingual-e5-small, 384 ulottuvuutta). "hash" = sanatiivisteet ilman mallia, vain testeihin.
EMBEDDING_MODEL=
# Mallin versio: Hugging Facen commit-tunniste. Oletusmallille lukittu oletus; versiomuutos laskee vektorit uudelleen.
EMBEDDING_MODEL_REVISION=
# Kansio, josta malli luetaan ja johon se ladataan (oletus DATA_DIR/models).
EMBEDDING_MODEL_DIR=
# false = mallia ei ladata Hugging Facesta ajon aikana; lataa se ensin komennolla npm run embeddings:download.
EMBEDDING_ALLOW_DOWNLOAD=
# Vähimmäissamankaltaisuus (kosini, oletus 0.8), jotta haku ei palauta mitään, kun mikään ei vastaa.
EMBEDDING_MIN_SIMILARITY=
# false = ei sqlite-vec-hakuindeksiä; vektoreita verrataan muistissa.
EMBEDDING_SQLITE_VEC=
