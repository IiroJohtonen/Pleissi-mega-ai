# Alusta: Kotilon palvelin tarjoaa rajapinnan ja käyttöliittymän samasta osoitteesta.
# Caddy hakee varmenteen vain tässä tiedostossa nimetyille osoitteille, joten jokaisen osoitteen
# DNS-tietueen pitää osoittaa tähän palvelimeen.
app.kotilo.io {
	encode zstd gzip
	reverse_proxy kotilo:4000
}

# Kotisivu (repon kansio site). Toistaiseksi testiosoitteessa: kotilo.io ja www.kotilo.io
# osoittavat vielä muualle. Kun niiden DNS-tietueet osoittavat tänne, lisää osoitteet tälle riville.
test.kotilo.io {
	root * /srv/site
	encode zstd gzip
	file_server
}
