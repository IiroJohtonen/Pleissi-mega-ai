# Kotilon asetukset palvelimella. Kopioidaan ensimmäisellä asennuksella nimelle /opt/kotilo/.env.
# Tiedosto sisältää salaisuuksia: älä lisää sitä repoon.

# Osoite, josta alusta avataan. Käytetään salasanan palautuslinkeissä ja sallittuna selainosoitteena.
APP_URL=https://app.kotilo.io
# Caddy on palvelimen edessä yhtenä välityspalvelimena.
TRUST_PROXY=1

# Ensimmäisten käyttäjien salasana tyhjään tietokantaan. Tyhjänä salasana arvotaan ja tulostetaan lokiin.
INITIAL_PASSWORD=

# Claude-avain AI-ehdotuksia, raportteja ja saapuvien viestien arviointia varten. Tyhjänä AI ei ole käytössä.
ANTHROPIC_API_KEY=

# Varmuuskopio otetaan kerran päivässä palvelimen kansioon /opt/kotilo/varmuuskopiot.
BACKUP_DIR=/backups
BACKUP_KEEP=14

# Gmail: Googlen kirjautuminen palaa tähän osoitteeseen, ja OAuth-clientin tiedosto luetaan
# palvelimen kansiosta /opt/kotilo/config.
GMAIL_REDIRECT_URI=https://app.kotilo.io/api/gmail/callback
GMAIL_CREDENTIALS_FILE=/config/credentials.json

DEFAULT_COMPANY_ID=demo-company
AUTHORIZED_COMPANY_IDS=demo-company
